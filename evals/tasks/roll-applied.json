{
  "prompt": "Create design.vixl at 800x800, then roll and apply a direction with seed 12, locking layout hero-statement, pairing source-serif-sans, palette ocean. Fill title Launch, subtitle A new beginning and CTA Learn more. The workspace font cache provides offline fixtures.",
  "document": "design.vixl",
  "checks": [
    {
      "type": "state_field",
      "field": [
        "layout",
        "name"
      ],
      "equals": "hero-statement"
    },
    {
      "type": "state_field",
      "field": [
        "layout",
        "palette"
      ],
      "equals": "ocean"
    },
    {
      "type": "state_field",
      "field": [
        "typography",
        "heading"
      ],
      "equals": "source-serif-4-600"
    },
    {
      "type": "layer",
      "name": "title",
      "match": {
        "name": "headline",
        "text_contains": "Launch"
      }
    }
  ],
  "reference": [
    {
      "tool": "vixl_document",
      "arguments": {
        "action": "create",
        "path": "design.vixl",
        "width": 800,
        "height": 800
      }
    },
    {
      "tool": "vixl_apply",
      "arguments": {
        "operations": [
          {
            "type": "roll",
            "seed": 12,
            "locks": {
              "layout": "hero-statement",
              "pairing": "source-serif-sans",
              "palette": "ocean"
            },
            "slots": {
              "title": "Launch",
              "subtitle": "A new beginning",
              "cta": "Learn more"
            }
          }
        ]
      }
    }
  ],
  "setup": {
    "font_pairings": [
      "source-serif-sans"
    ]
  }
}

    "table": {"parent": "furniture", "aliases": ["desk"], "summary": "A table: top and legs.", "parts": [{"name": "top", "required": true}, {"name": "leg", "count": 4, "required": true}], "connections": [["leg", "top"]]},
    "tool": {"parent": "constructed", "summary": "A hand tool."},

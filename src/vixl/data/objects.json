    "badge": {"parent": "symbolic", "aliases": ["sticker", "patch", "seal"], "summary": "A badge: a shape, a border and a label.", "parts": [{"name": "shape", "required": true}, {"name": "border"}, {"name": "label"}], "connections": [["border", "shape"], ["label", "shape"]]},

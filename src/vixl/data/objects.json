    "bottle": {"parent": "container", "aliases": ["jar", "flask"], "summary": "A bottle: body, neck and cap.", "parts": [{"name": "body", "required": true}, {"name": "neck"}, {"name": "cap"}, {"name": "label"}], "connections": [["neck", "body"], ["cap", "neck"], ["label", "body"]]},

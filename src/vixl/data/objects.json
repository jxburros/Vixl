    "piano": {"parent": "instrument", "aliases": ["keyboard", "grand-piano"], "summary": "A piano: case, keys and legs.", "parts": [{"name": "case", "required": true}, {"name": "keys", "required": true}, {"name": "leg", "count": 3}], "connections": [["keys", "case"], ["leg", "case"]]},
    "drum": {"parent": "instrument", "aliases": ["drum-kit", "snare"], "summary": "A drum: shell, head and rims.", "parts": [{"name": "shell", "required": true}, {"name": "head", "required": true}, {"name": "rim", "count": 2}], "connections": [["head", "shell"], ["rim", "shell"]]},
    "vehicle": {"parent": "constructed", "summary": "Something that carries people or goods."},
    "car": {"parent": "vehicle", "aliases": ["automobile", "truck", "van"], "summary": "A car: body, windows and wheels.",
      "parts": [{"name": "body", "required": true}, {"name": "window", "count": 2}, {"name": "wheel", "count": 2, "required": true}, {"name": "light", "count": 2}],
      "connections": [["wheel", "body"], ["window", "body"]], "layering": ["far wheels", "body", "windows", "near wheels"], "symmetry": "none"},
    "bicycle": {"parent": "vehicle", "aliases": ["bike", "cycle"], "summary": "A bicycle: frame, two wheels, handlebar and seat.",

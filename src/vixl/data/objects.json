{
  "version": 1,
  "about": "Object taxonomy: domain > class > kind. Each entry inherits every field from its parent; parts+ and connections+ extend the inherited list, the other fields replace it. Parts: name, required, count, side (left/right pairs), sub_object (a kind). Connections: part pairs that must touch. Proportions: a part's size relative to a reference (height of the whole object unless 'of' names a part). Layering: back-to-front order hints. Outline: the default outline policy.",
  "kinds": {
    "organic": {"summary": "Living things and their parts.", "outline": {"silhouette": true, "internal": "thin", "weight": "uniform"}},
    "constructed": {"summary": "Made things: instruments, vehicles, buildings, furniture, tools, devices and containers.", "outline": {"silhouette": true, "internal": "thin", "weight": "uniform"}},
    "natural": {"summary": "Landscape and weather forms without a fixed anatomy.", "outline": {"silhouette": false, "internal": "none"}},
    "symbolic": {"summary": "Signs drawn to be read, not depicted: icons, badges, emblems.", "outline": {"silhouette": true, "internal": "same", "weight": "uniform"}},
    "texture": {"summary": "Surface patterns (fur, spots, scales, cells). Not objects: apply them to an object's parts.", "texture": true},

    "person": {"parent": "organic", "aliases": ["human", "figure", "people", "man", "woman", "character"], "summary": "A human figure. A standard character (the character operation) is a person: its character parts read as these parts.",
      "parts": [
        {"name": "head", "required": true},
        {"name": "hair"},
        {"name": "eye", "count": 2, "side": true, "required": true},
        {"name": "brow", "count": 2, "side": true},
        {"name": "mouth", "required": true},
        {"name": "torso", "required": true},
        {"name": "upper-arm", "count": 2, "side": true, "required": true},
        {"name": "lower-arm", "count": 2, "side": true, "required": true},
        {"name": "hand", "count": 2, "side": true, "required": true},
        {"name": "upper-leg", "count": 2, "side": true, "required": true},
        {"name": "lower-leg", "count": 2, "side": true, "required": true},
        {"name": "foot", "count": 2, "side": true, "required": true},
        {"name": "accessories"}
      ],
      "connections": [["head", "torso"], ["upper-arm", "torso"], ["lower-arm", "upper-arm"], ["hand", "lower-arm"], ["upper-leg", "torso"], ["lower-leg", "upper-leg"], ["foot", "lower-leg"], ["eye", "head"], ["mouth", "head"]],
      "proportions": [{"part": "head", "of": "height", "min": 0.125, "max": 0.143, "note": "adult realism: 7 to 8 heads tall"}],
      "symmetry": "bilateral",
      "layering": ["far limbs", "torso", "near limbs", "head", "hair", "features"]},
    "adult": {"parent": "person", "aliases": ["grown-up"], "summary": "An adult figure, about 7.5 heads tall."},
    "child": {"parent": "person", "aliases": ["kid", "toddler"], "summary": "A child figure: a larger head, 4 to 6 heads tall.",
      "proportions": [{"part": "head", "of": "height", "min": 0.17, "max": 0.25, "note": "4 to 6 heads tall"}]},
    "mascot-figure": {"parent": "person", "aliases": ["mascot", "cartoon-person", "chibi"], "summary": "A stylised figure: big head, short limbs, simple features.",
      "proportions": [{"part": "head", "of": "height", "min": 0.25, "max": 0.5, "note": "2 to 4 heads tall"}]},

    "animal": {"parent": "organic", "summary": "An animal: a head and a body, with species-specific limbs.",
      "parts": [{"name": "head", "required": true}, {"name": "body", "required": true}, {"name": "eye", "count": 2, "side": true}],
      "connections": [["head", "body"], ["eye", "head"]],
      "symmetry": "bilateral",
      "layering": ["far limbs", "tail", "body", "near limbs", "head", "features"]},
    "mammal": {"parent": "animal", "summary": "A four-legged mammal.",
      "parts+": [{"name": "ear", "count": 2, "side": true}, {"name": "leg", "count": 4, "required": true}, {"name": "tail"}],
      "connections+": [["leg", "body"], ["tail", "body"], ["ear", "head"]],
      "proportions": [{"part": "head", "of": "body", "min": 0.3, "max": 0.6, "note": "head width against body length"}]},
    "dog": {"parent": "mammal", "aliases": ["puppy", "hound", "canine", "doggy"], "summary": "A dog: snout, floppy or pointed ears, four legs and a tail.",
      "parts+": [{"name": "snout"}, {"name": "nose"}],
      "connections+": [["snout", "head"]]},
    "cat": {"parent": "mammal", "aliases": ["kitten", "kitty", "feline"], "summary": "A cat: round head, pointed ears, whiskers and a long tail.",
      "parts+": [{"name": "whiskers"}, {"name": "nose"}]},
    "horse": {"parent": "mammal", "aliases": ["pony", "foal"], "summary": "A horse: long head and neck, mane, four long legs.",
      "parts+": [{"name": "neck", "required": true}, {"name": "mane"}],
      "connections+": [["neck", "body"], ["head", "neck"]],
      "proportions": [{"part": "leg", "of": "height", "min": 0.45, "max": 0.6}]},
    "rabbit": {"parent": "mammal", "aliases": ["bunny", "hare"], "summary": "A rabbit: long ears, round body, short tail."},
    "bear": {"parent": "mammal", "aliases": ["teddy", "teddy-bear"], "summary": "A bear: heavy body, round ears, short tail."},
    "giraffe": {"parent": "mammal", "summary": "A giraffe: very long neck and legs, patched coat (the giraffe organic preset is its coat texture).",
      "parts+": [{"name": "neck", "required": true}, {"name": "ossicone", "count": 2}],
      "connections+": [["neck", "body"], ["head", "neck"]]},
    "bird": {"parent": "animal", "aliases": ["birdie", "chick"], "summary": "A bird: beak, wings, two legs and tail feathers.",
      "parts+": [{"name": "beak", "required": true}, {"name": "wing", "count": 2, "side": true, "required": true}, {"name": "leg", "count": 2, "side": true}, {"name": "tail"}],
      "connections+": [["beak", "head"], ["wing", "body"], ["leg", "body"], ["tail", "body"]]},
    "fish": {"parent": "animal", "summary": "A fish: body, fins and a tail fin.",
      "parts+": [{"name": "fin", "count": 2}, {"name": "tail-fin", "required": true}],
      "connections+": [["fin", "body"], ["tail-fin", "body"]]},
    "insect": {"parent": "animal", "aliases": ["bug"], "summary": "An insect: head, thorax and abdomen, six legs, antennae.",
      "parts": [{"name": "head", "required": true}, {"name": "thorax", "required": true}, {"name": "abdomen", "required": true}, {"name": "leg", "count": 6}, {"name": "antenna", "count": 2, "side": true}, {"name": "wing", "count": 2, "side": true}],
      "connections": [["head", "thorax"], ["abdomen", "thorax"], ["leg", "thorax"], ["antenna", "head"], ["wing", "thorax"]]},
    "caterpillar": {"parent": "insect", "aliases": ["larva"], "summary": "A caterpillar: a head and a chain of round segments.",
      "parts": [{"name": "head", "required": true}, {"name": "segment", "count": 6, "required": true}, {"name": "antenna", "count": 2, "side": true}],
      "connections": [["head", "segment"], ["segment", "segment"]]},
    "cephalopod": {"parent": "animal", "summary": "An octopus or squid: a mantle and arms.",
      "parts": [{"name": "mantle", "required": true}, {"name": "arm", "count": 8, "required": true}, {"name": "eye", "count": 2, "side": true}],
      "connections": [["arm", "mantle"], ["eye", "mantle"]], "symmetry": "radial"},
    "octopus": {"parent": "cephalopod", "aliases": ["squid"], "summary": "An octopus: round mantle and eight curling arms."},
    "jellyfish": {"parent": "animal", "aliases": ["jelly", "medusa"], "summary": "A jellyfish: a bell and trailing tentacles.",
      "parts": [{"name": "bell", "required": true}, {"name": "tentacle", "count": 6, "required": true}],
      "connections": [["tentacle", "bell"]], "symmetry": "radial"},
    "starfish": {"parent": "animal", "aliases": ["sea-star"], "summary": "A starfish: five arms around a centre.",
      "parts": [{"name": "arm", "count": 5, "required": true}], "connections": [], "symmetry": "radial"},
    "coral": {"parent": "animal", "summary": "Coral: a branching or folded colony.", "parts": [{"name": "branch", "count": 3}], "connections": [["branch", "branch"]], "symmetry": "none"},
    "brain-coral": {"parent": "coral", "summary": "Brain coral: a dome with winding grooves."},
    "mollusc": {"parent": "animal", "aliases": ["mollusk"], "summary": "A soft-bodied animal, often with a shell.",
      "parts": [{"name": "body", "required": true}, {"name": "shell"}], "connections": [["shell", "body"]]},
    "snail": {"parent": "mollusc", "aliases": ["slug"], "summary": "A snail: a spiral shell on a soft body with eye stalks.",
      "parts+": [{"name": "eye-stalk", "count": 2, "side": true}], "connections+": [["eye-stalk", "body"]]},
    "shell": {"parent": "mollusc", "aliases": ["seashell", "conch"], "summary": "An empty seashell.", "parts": [{"name": "shell", "required": true}], "connections": []},
    "worm": {"parent": "animal", "aliases": ["earthworm"], "summary": "A worm: a chain of segments.", "parts": [{"name": "segment", "count": 6, "required": true}], "connections": [["segment", "segment"]]},

    "botanical": {"parent": "organic", "aliases": ["plant", "plants"], "summary": "Plants and their parts.", "symmetry": "radial"},
    "tree": {"parent": "botanical", "summary": "A tree: trunk and canopy, optional branches and roots.",
      "parts": [{"name": "trunk", "required": true}, {"name": "canopy", "required": true}, {"name": "branch", "count": 3}, {"name": "root"}],
      "connections": [["trunk", "canopy"], ["branch", "trunk"], ["root", "trunk"]],
      "proportions": [{"part": "trunk", "of": "height", "min": 0.25, "max": 0.5}],
      "layering": ["roots", "trunk", "branches", "canopy"], "symmetry": "none"},
    "oak": {"parent": "tree", "summary": "An oak: thick trunk and broad round canopy."},
    "pine": {"parent": "tree", "aliases": ["conifer", "fir", "spruce", "christmas-tree"], "summary": "A conifer: a cone-shaped canopy of tiers.",
      "proportions": [{"part": "trunk", "of": "height", "min": 0.1, "max": 0.25}]},
    "palm": {"parent": "tree", "aliases": ["palm-tree"], "summary": "A palm: tall curved trunk and a crown of fronds.",
      "parts": [{"name": "trunk", "required": true}, {"name": "frond", "count": 6, "required": true}],
      "connections": [["frond", "trunk"]]},
    "flower": {"parent": "botanical", "aliases": ["blossom", "bloom"], "summary": "A flower: petals around a centre on a stem.",
      "parts": [{"name": "petal", "count": 5, "required": true}, {"name": "center", "required": true}, {"name": "stem"}, {"name": "leaf", "count": 2}],
      "connections": [["petal", "center"], ["stem", "center"], ["leaf", "stem"]],
      "layering": ["stem", "leaves", "petals", "center"]},
    "rose": {"parent": "flower", "summary": "A rose: cupped spiral petals."},
    "daisy": {"parent": "flower", "summary": "A daisy: many thin white petals around a yellow centre."},
    "sunflower": {"parent": "flower", "summary": "A sunflower: a large seeded centre ringed with yellow petals."},
    "dandelion": {"parent": "flower", "summary": "A dandelion seed head: a sphere of fine seeds on a stem.",
      "parts": [{"name": "seed-head", "required": true}, {"name": "stem"}], "connections": [["stem", "seed-head"]]},
    "leaf": {"parent": "botanical", "aliases": ["foliage"], "summary": "A single leaf: blade and stalk.",
      "parts": [{"name": "blade", "required": true}, {"name": "vein"}, {"name": "stalk"}], "connections": [["stalk", "blade"]], "symmetry": "bilateral"},
    "frond": {"parent": "leaf", "summary": "A frond: a long leaf split into leaflets."},
    "fern": {"parent": "botanical", "summary": "A fern: curling fronds from one base.", "parts": [{"name": "frond", "count": 3, "required": true}], "connections": [["frond", "frond"]]},
    "branch": {"parent": "botanical", "aliases": ["twig"], "summary": "A branch with leaves.", "parts": [{"name": "stem", "required": true}, {"name": "leaf", "count": 4}], "connections": [["leaf", "stem"]], "symmetry": "none"},
    "vine": {"parent": "botanical", "aliases": ["ivy", "creeper"], "summary": "A climbing vine with leaves.", "parts": [{"name": "stem", "required": true}, {"name": "leaf", "count": 4}], "connections": [["leaf", "stem"]], "symmetry": "none"},
    "grass": {"parent": "botanical", "aliases": ["lawn", "tuft"], "summary": "Grass blades from a base line.", "parts": [{"name": "blade", "count": 5, "required": true}], "connections": [], "symmetry": "none"},
    "cactus": {"parent": "botanical", "aliases": ["succulent", "potted-cactus"], "summary": "A cactus: ribbed body, spines, optional arms, flower and pot.",
      "parts": [{"name": "body", "required": true}, {"name": "arm", "count": 2}, {"name": "spine"}, {"name": "flower"}, {"name": "pot", "sub_object": "pot"}],
      "connections": [["arm", "body"], ["flower", "body"], ["body", "pot"]],
      "layering": ["pot back", "body", "arms", "spines", "flower", "pot rim"], "symmetry": "bilateral"},
    "lily-pad": {"parent": "botanical", "aliases": ["water-lily"], "summary": "A floating round leaf with a notch.", "parts": [{"name": "pad", "required": true}, {"name": "flower"}], "connections": [["flower", "pad"]]},
    "pinecone": {"parent": "botanical", "aliases": ["pine-cone", "cone"], "summary": "A pinecone: overlapping scales.", "parts": [{"name": "scale", "count": 8, "required": true}], "connections": [["scale", "scale"]]},
    "fungus": {"parent": "organic", "summary": "Fungi."},
    "mushroom": {"parent": "fungus", "aliases": ["toadstool"], "summary": "A mushroom: cap on a stem, optional gills and spots.",
      "parts": [{"name": "cap", "required": true}, {"name": "stem", "required": true}, {"name": "gills"}, {"name": "spots"}],
      "connections": [["stem", "cap"]], "layering": ["stem", "gills", "cap", "spots"], "symmetry": "bilateral"},
    "feather": {"parent": "organic", "aliases": ["quill", "plume"], "summary": "A feather: a shaft with vanes on both sides.", "parts": [{"name": "shaft", "required": true}, {"name": "vane", "count": 2, "side": true}], "connections": [["vane", "shaft"]], "symmetry": "bilateral"},
    "cell": {"parent": "organic", "aliases": ["microbe", "bacterium"], "summary": "A cell: membrane, nucleus and organelles.", "parts": [{"name": "membrane", "required": true}, {"name": "nucleus"}], "connections": [["nucleus", "membrane"]]},

    "instrument": {"parent": "constructed", "aliases": ["musical-instrument"], "summary": "A musical instrument."},
    "guitar": {"parent": "instrument", "aliases": ["acoustic-guitar", "electric-guitar", "ukulele", "bass-guitar"], "summary": "A guitar: body, neck, headstock, strings, sound hole and bridge.",
      "parts": [{"name": "body", "required": true}, {"name": "neck", "required": true}, {"name": "headstock", "required": true}, {"name": "strings", "required": true}, {"name": "sound-hole"}, {"name": "bridge"}, {"name": "tuning-peg", "count": 6}, {"name": "fret"}],
      "connections": [["neck", "body"], ["headstock", "neck"], ["bridge", "body"], ["tuning-peg", "headstock"]],
      "proportions": [{"part": "neck", "of": "body", "min": 0.45, "max": 0.7, "note": "neck length against body height"}],

{
  "name": "vixl-house-style",
  "version": 2,
  "description": "Vixl's built-in default brand. Craft is fixed and the same everywhere; taste is rolled from tiered pools, gated by the variety level and weighted by purpose. A workspace brand.json and explicit fields override it. Changing a value here changes new documents only: documents store their rolled design_defaults with the house_style_version that made them.",
  "precedence": ["explicit field", "brand (brand.json)", "purpose profile", "document design_defaults", "seeded roll"],
  "craft": {
    "signature": [
      "sharp corners",
      "thin part lines",
      "offset shadows",
      "uppercase labels",
      "one line-height rule"
    ],
    "contrast": {"text": 4.5, "large_text": 3.0, "ink_target": 7.1, "secondary_text_target": 4.6, "fill": 3.0},
    "spacing": {"unit": 0.5, "unit_of": "body size", "minimum_unit": 2, "steps": [1, 2, 3, 4, 6, 8]},
    "line_height": {"display": 1.0, "heading": 1.1, "lead": 1.35, "body": 1.45, "caption": 1.3},
    "line_length": {"min": 45, "max": 75},
    "minimum_text": {"minor_share_of_short_side": 0.022, "print_points": 6, "large_text_px": 24, "large_bold_text_px": 18.66},
    "base_size": {"screen_share_of_short_side": 0.026, "screen_minimum_px": 10, "print_points_per_inch_of_short_side": 1.25,
                  "print_minimum_points": 7.5, "print_maximum_points": 60},
    "headline_measure": {"display": 10, "heading": 14, "large_display": 8, "large_heading": 8, "glyph_width": 0.56},
    "safe_area": 0.05,
    "stroke_width": 0.015,
    "neutral_fill": "#8c8c8c",
    "fill_roles": {"shape": "accent", "solid": "surface", "stroke": "ink"},
    "corner": "sharp",
    "corner_scale": {"sharp": 0, "soft": 0.08, "round": 0.25, "pill": 0.5},
    "irregular_strength": "subtle",
    "outline": "thin part lines",
    "shadow": "offset",
    "label_case": "upper",
    "margins": [0.07, 0.085, 0.10]
  },
  "taste": {
    "tiers": ["safe", "bold", "avant-garde"],
    "tier_notes": {
      "safe": "Broad-use choices that suit most briefs.",
      "bold": "Characterful but robust: rolled sometimes at medium variety, often at high.",
      "avant-garde": "Unusual and expressive: rolled rarely at medium, sometimes at high.",
      "explicit": "Specialised entries (scripts, memes, products, single-purpose layouts): never rolled, available by name."
    },
    "levels": {
      "low": {
        "summary": "Safe pools only, flat or gradient backgrounds, a light finishing look.",
        "tiers": {"safe": 1.0},
        "look_scale": 0.8,
        "motifs": {"none": 2, "rule": 1},
        "treatments": {"flat": 3, "gradient": 1}
      },
      "medium": {
        "summary": "Mostly safe, sometimes bold, rarely avant-garde; the purpose's finishing look at its normal amount.",
        "tiers": {"safe": 0.75, "bold": 0.2, "avant-garde": 0.05},
        "look_scale": 1.0,
        "motifs": {"none": 1, "rule": 1, "ellipse": 1},
        "treatments": {"flat": 3, "gradient": 2}
      },
      "high": {
        "summary": "Every tier, every background treatment and a stronger finishing look.",
        "tiers": {"safe": 0.45, "bold": 0.35, "avant-garde": 0.2},
        "look_scale": 1.5,
        "motifs": {"none": 1, "rule": 1, "ellipse": 1, "rectangle": 1},
        "treatments": {"flat": 2, "gradient": 2, "split": 1, "pattern": 1}
      },
      "fixed": {"like": "medium", "summary": "Medium pools with a fixed seed (workspace .vixl/variety.json)."}
    },
    "moods": {
      "expressive": ["playful", "bold", "loud", "energetic", "dramatic", "youthful", "fun", "festive", "quirky", "expressive", "vibrant", "retro", "edgy"],
      "quiet": ["calm", "minimal", "quiet", "serious", "corporate", "formal", "academic", "trustworthy", "neutral", "clean"],
      "expressive_tier_scale": {"safe": 0.4, "bold": 1.6, "avant-garde": 2.0},
      "quiet_tier_scale": {"safe": 1.5, "bold": 0.7, "avant-garde": 0.3},
      "match_weight": 4
    },
    "mode": {"dark": 0.34},
    "type_scales": ["minor-third", "major-third", "perfect-fourth", "perfect-fifth", "golden"],

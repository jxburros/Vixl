{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/jxburros/Vixl/src/vixl/data/catalog.schema.json",
 "title": "Vixl design catalog bundle",
 "description": "Written by `vixl catalog export` (Python: vixl.catalog.export_catalog). catalog_schema_version changes only when a field is removed or changes meaning; new fields and entries can appear in any release, so readers should ignore what they do not know.",
 "type": "object",
 "required": ["catalog_schema_version", "vixl_version", "counts"],
 "properties": {
  "catalog_schema_version": {"const": 1, "description": "Bundle format version."},
  "vixl_version": {"type": "string", "description": "The Vixl release that wrote the bundle."},
  "schema": {"type": "string", "description": "Where this schema lives for that release."},
  "counts": {
   "type": "object",
   "description": "Number of entries per section (typefaces: families, pairings and type_scales).",
   "additionalProperties": {"type": "integer", "minimum": 0}
  },
  "sizes": {
   "type": "object",
   "required": ["categories", "items", "aliases"],
   "properties": {
    "categories": {"type": "array", "items": {"type": "string"}},
    "aliases": {"type": "object", "additionalProperties": {"type": "string"}},
    "items": {
     "type": "array",
     "items": {
      "type": "object",
      "required": ["name", "category", "description", "unit", "width", "height", "pixels", "safe", "safe_pixels"],
      "properties": {
       "name": {"type": "string"},
       "category": {"type": "string"},
       "description": {"type": "string"},
       "unit": {"enum": ["px", "in", "mm"], "description": "Unit of width, height, safe and bleed."},
       "width": {"type": "number", "exclusiveMinimum": 0},
       "height": {"type": "number", "exclusiveMinimum": 0},
       "pixels": {"$ref": "#/$defs/pair", "description": "Trim size in pixels at dpi."},
       "dpi": {"type": "number", "description": "Print sizes only: default resolution."},
       "bleed": {
        "type": "object",
        "description": "Print sizes only: the standard bleed added on every side when bleed is requested.",
        "required": ["unit", "amount", "pixels"],
        "properties": {"unit": {"type": "string"}, "amount": {"type": "number"}, "pixels": {"type": "number"}}
       },
       "safe": {"$ref": "#/$defs/sides", "description": "Safe (live) area inset from the trim edge, in unit."},
       "safe_pixels": {"$ref": "#/$defs/sides", "description": "The same inset in pixels."}
      }
     }
    }
   }
  },
  "palettes": {
   "type": "object",
   "required": ["roles", "items"],
   "properties": {
    "roles": {"type": "array", "items": {"type": "string"}},
    "house_style_version": {"type": "integer"},
    "contrast_targets": {"type": "object", "additionalProperties": {"type": "number"}},
    "items": {
     "type": "array",
     "items": {
      "type": "object",
      "required": ["name", "colors", "tier", "safe", "mood", "modes"],
      "properties": {
       "name": {"type": "string"},
       "colors": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/hex"}},
       "tier": {"type": "string"},
       "safe": {"type": "boolean"},
       "mood": {"type": "array", "items": {"type": "string"}},
       "modes": {
        "type": "object",
        "description": "Per mode (light, dark): the role colors layout-apply and palette-apply assign, and their contrast ratios.",
        "additionalProperties": {
         "type": "object",
         "required": ["roles", "contrast"],
         "properties": {
          "roles": {"type": "object", "additionalProperties": {"$ref": "#/$defs/hex"}},
          "contrast": {"type": "object", "additionalProperties": {"type": "number", "minimum": 1, "maximum": 21}}
         }
        }
       }
      }
     }
    }
   }
  },
  "typefaces": {
   "type": "object",
   "required": ["families", "pairings", "type_scales"],
   "properties": {
    "families": {
     "type": "array",
     "description": "Font family metadata (Google Fonts, open licensed). No font files are included.",
     "items": {
      "type": "object",
      "required": ["family", "category", "weights"],
      "properties": {
       "family": {"type": "string"},
       "category": {"type": "string"},
       "weights": {"type": "array", "items": {"type": "integer"}},
       "italic": {"type": "boolean"}
      }
     }
    },
    "pairings": {
     "type": "array",
     "items": {
      "type": "object",
      "required": ["name", "heading", "body"],
      "properties": {
       "name": {"type": "string"},
       "heading": {"$ref": "#/$defs/face"},
       "body": {"$ref": "#/$defs/face"},
       "mood": {"type": "array", "items": {"type": "string"}},
       "tier": {"type": "string"},
       "safe": {"type": "boolean"}
      }
     }
    },
    "type_scales": {
     "type": "array",
     "items": {
      "type": "object",
      "required": ["name", "ratio"],
      "properties": {"name": {"type": "string"}, "ratio": {"type": "number", "exclusiveMinimum": 1}}
     }
    },
    "type_scale_steps": {
     "type": "object",
     "description": "Text role to its step on the modular scale (body is 0).",
     "additionalProperties": {"type": "integer"}
    }
   }
  },
  "layouts": {
   "type": "object",
   "required": ["reference", "items"],
   "properties": {
    "reference": {"type": "object"},
    "items": {
     "type": "array",
     "items": {
      "type": "object",
      "required": ["name", "description", "tier", "best_for", "slots", "proportions"],
      "properties": {
       "name": {"type": "string"},
       "description": {"type": "string"},
       "tier": {"type": "string"},
       "safe": {"type": "boolean"},
       "best_for": {"type": "array", "items": {"type": "string"}},
       "principles": {"type": "array", "items": {"type": "string"}},
       "slots": {
        "type": "object",
        "additionalProperties": {
         "type": "object",
         "required": ["label"],
         "properties": {"label": {"type": "string"}, "hint": {"type": "string"}}
        }
       },
       "also_accepts": {"type": "array", "items": {"type": "string"}},
       "proportions": {
        "type": "object",
        "description": "Slot to [x, y, width, height] as fractions of the reference canvas.",
        "additionalProperties": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}}
       }
      }
     }
    }
   }
  },
  "briefs": {
   "type": "object",
   "required": ["items"],
   "properties": {
    "start_here": {"type": "array", "items": {"type": "string"}},
    "items": {
     "type": "array",
     "items": {
      "type": "object",
      "required": ["kind", "title", "summary", "size_category", "sizes", "layouts", "looks", "styles", "checks"],
      "properties": {
       "kind": {"type": "string"},
       "title": {"type": "string"},
       "summary": {"type": "string"},
       "size_category": {"type": ["string", "null"]},
       "sizes": {"type": "array", "items": {"type": "string"}},
       "layouts": {"type": "array", "items": {"type": "string"}},
       "looks": {"type": "array", "items": {"type": "string"}},
       "styles": {"type": "array", "items": {"type": "string"}},
       "guidance": {"type": "array", "items": {"type": "string"}},
       "checks": {
        "type": "object",
        "required": ["starter_suite", "rules"],
        "properties": {"starter_suite": {"type": "string"}, "rules": {"type": "array", "items": {"$ref": "#/$defs/rule"}}}
       }
      }
     }
    }
   }
  },
  "guidance": {
   "type": "object",
   "required": ["items"],
   "properties": {
    "items": {
     "type": "array",
     "items": {
      "type": "object",
      "required": ["name", "summary", "text"],
      "properties": {"name": {"type": "string"}, "summary": {"type": "string"}, "text": {"type": "string"}}
     }
    }
   }
  },
  "looks": {
   "type": "object",
   "required": ["items"],
   "properties": {
    "items": {
     "type": "array",
     "items": {
      "type": "object",
      "required": ["name", "summary"],
      "properties": {"name": {"type": "string"}, "summary": {"type": "string"}, "tier": {"type": "string"}}
     }
    }
   }
  },
  "styles": {
   "type": "object",
   "required": ["items"],
   "properties": {
    "items": {
     "type": "array",
     "items": {
      "type": "object",
      "required": ["name", "title", "summary", "rules"],
      "properties": {
       "name": {"type": "string"},
       "title": {"type": "string"},
       "summary": {"type": "string"},
       "rules": {"type": "array", "items": {"type": "string"}, "description": "IDs in checks.style_rules."}
      }
     }
    }
   }
  },
  "checks": {
   "type": "object",
   "required": ["actions", "items", "suites", "style_rules", "suite_rule_kinds"],
   "properties": {
    "actions": {"type": "array", "items": {"enum": ["fix", "review", "informational"]}},
    "default": {"type": "array", "items": {"type": "string"}},
    "optional": {"type": "array", "items": {"type": "string"}},
    "deck": {"type": "array", "items": {"type": "string"}},
    "defaults": {"type": "object", "description": "Default check settings (thresholds)."},
    "items": {
     "type": "array",
     "description": "Every check. A finding's check field is one of these ids; its severity is one of the listed severities and its action follows actions.",
     "items": {
      "type": "object",
      "required": ["id", "family", "description", "severities", "actions"],
      "properties": {
       "id": {"type": "string"},
       "family": {"enum": ["default", "optional", "deck", "report"]},
       "description": {"type": "string"},
       "severities": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/severity"}},
       "actions": {"type": "object", "additionalProperties": {"enum": ["fix", "review", "informational"]}}
      }
     }
    },
    "suite_rule_kinds": {"type": "array", "items": {"type": "string"}},
    "suite_rule_kind_description": {"type": "string"},
    "suites": {
     "type": "array",
     "items": {
      "type": "object",
      "required": ["name", "rules"],
      "properties": {
       "name": {"type": "string"},
       "description": {"type": "string"},
       "rules": {"type": "array", "items": {"$ref": "#/$defs/rule"}}
      }
     }
    },
    "style_rules": {
     "type": "array",
     "items": {
      "type": "object",
      "required": ["style", "id", "kind", "severity", "summary", "thresholds"],
      "properties": {
       "style": {"type": "string"},
       "id": {"type": "string"},
       "kind": {"type": "string"},
       "severity": {"$ref": "#/$defs/severity"},
       "summary": {"type": "string"},
       "fix": {"type": "string"},
       "thresholds": {"type": "object"}
      }
     }
    }
   }
  }
 },
 "$defs": {
  "hex": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"},
  "pair": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
  "sides": {
   "type": "object",
   "required": ["left", "top", "right", "bottom"],
   "properties": {"left": {"type": "number"}, "top": {"type": "number"}, "right": {"type": "number"}, "bottom": {"type": "number"}}
  },
  "face": {
   "type": "object",
   "required": ["family", "weight"],
   "properties": {"family": {"type": "string"}, "weight": {"type": "integer"}}
  },
  "severity": {"enum": ["error", "warning", "info"]},
  "rule": {
   "type": "object",
   "required": ["id", "kind"],
   "properties": {"id": {"type": "string"}, "kind": {"type": "string"}, "severity": {"enum": ["error", "warning"]}}
  }
 }
}
